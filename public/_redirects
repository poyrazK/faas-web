# Server-rendered CLI authorization must stay on the public console origin;
# proxy it to apid before the SPA fallback. This preserves the browser session
# cookie while keeping the API implementation behind the edge.
/cli-auth    https://api.gregale.dev/cli-auth   200
/status/slo.json    https://api.gregale.dev/status/slo.json   200
/status/incidents/*    /status/incidents/index.html   200

