{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/dashboard/install/connect$",
      "methods": ["POST"],
      "dest": "https://api.gregale.dev/dashboard/install/connect"
    },
    {
      "src": "^/dashboard/account/set-password$",
      "methods": ["POST"],
      "dest": "https://api.gregale.dev/dashboard/account/set-password"
    },
    {
      "src": "^/cli-auth$",
      "methods": ["GET", "HEAD", "POST", "OPTIONS"],
      "dest": "https://api.gregale.dev/cli-auth"
    },
    {
      "src": "^/oauth(?:/(.*))?$",
      "methods": ["GET", "HEAD", "OPTIONS"],
      "dest": "https://api.gregale.dev/oauth/$1"
    },
    {
      "src": "^/v1(?:/(.*))?$",
      "methods": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "dest": "https://api.gregale.dev/v1/$1"
    },
    {
      "src": "^/status/slo\\.json$",
      "methods": ["GET", "HEAD", "OPTIONS"],
      "dest": "https://api.gregale.dev/status/slo.json"
    },
    {
      "src": "^/auth(?:/(.*))?$",
      "methods": ["GET", "HEAD", "POST", "OPTIONS"],
      "dest": "https://api.gregale.dev/auth/$1"
    },
    {
      "src": "^/login$",
      "methods": ["POST"],
      "dest": "https://api.gregale.dev/login"
    },
    {
      "src": "^/signup$",
      "methods": ["POST"],
      "dest": "https://api.gregale.dev/signup"
    },
    {
      "src": "^/login/forgot$",
      "methods": ["POST"],
      "dest": "https://api.gregale.dev/login/forgot"
    },
    {
      "src": "^/logout$",
      "methods": ["POST"],
      "dest": "https://api.gregale.dev/logout"
    },
    {
      "src": "^/(.*)$",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-MNBQwotLG5DJJPjqm7mmsrZ5jFzjP9gENmE8qh74Ajo='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.fontshare.com; img-src 'self' data: blob: https:; connect-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'; frame-src 'none'; upgrade-insecure-requests",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), geolocation=(), microphone=(), payment=(), usb=()",
        "Access-Control-Allow-Origin": "https://gregale.dev"
      },
      "continue": true
    },
    {
      "src": "^/assets/(.*)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/index\\.html$",
      "headers": { "Cache-Control": "no-cache" },
      "continue": true
    },
    {
      "src": "^/status/incidents/[^/]+$",
      "dest": "/status/incidents/index.html",
      "headers": { "X-Robots-Tag": "noindex, follow" }
    },
    { "handle": "filesystem" },
    { "src": "^/docs(?:/.*)?$", "status": 404, "dest": "/404.html" },
    { "src": "^(?:/(.*))?$", "dest": "/index.html" }
  ]
}
