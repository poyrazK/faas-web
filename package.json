{
  "name": "gregaleweb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "dev:mock": "MOCK_API=1 vite --port 3000",
    "build:mock": "MOCK_API=1 vite build --mode development --outDir dist-mock",
    "preview:mock": "MOCK_API=1 vite preview --outDir dist-mock --port 4173",
    "tour": "node scripts/tour.mjs",
    "build": "tsc && vite build && npm run prerender",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript api/openapi.yaml -o src/lib/api/schema.d.ts --default-non-nullable=false",
    "api:pull": "curl -fsSL https://raw.githubusercontent.com/poyrazK/faas/main/api/openapi.yaml -o api/openapi.yaml && npm run api:types",
    "docs:pull": "node scripts/pull-docs.mjs",
    "capabilities:pull": "node scripts/pull-capabilities.mjs",
    "parity": "node scripts/parity-report.mjs",
    "smoke:hosting": "node scripts/smoke-hosting.mjs",
    "og": "node scripts/og-image.mjs",
    "lint": "eslint . --max-warnings 8",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "prerender": "vite build --ssr src/prerender.tsx --outDir dist-ssr --logLevel warn && node scripts/prerender.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@vercel/analytics": "^2.0.1",
    "border-beam": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "glimm": "^0.3.1",
    "iconoir-react": "^7.12.1",
    "motion": "^14.7.1",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
